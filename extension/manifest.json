{
  "manifest_version": 3,
  "name": "Basira Classroom Bridge",
  "version": "1.5.2",
  "description": "Lets Basira open and read Classroom and Docs tabs, following the tab the agent is using.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "activeTab",
    "alarms",
    "windows"
  ],
  "host_permissions": [
    "https://classroom.google.com/*",
    "https://docs.google.com/*",
    "https://*.googleusercontent.com/*",
    "http://127.0.0.1:8790/*",
    "http://localhost:8790/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Basira Classroom",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
